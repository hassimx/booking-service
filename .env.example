# Copy this file to .env and fill it in.
# The easy way: run "python create_env.py" and it writes .env for you.

# SQLite file by default. For PostgreSQL use something like
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./booking.db

# Long random text that signs the admin cookie. Make one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login. Only the hash of the password is stored here, never the password.
# create_env.py makes the hash for you.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Set to true when the site runs on https (for example on Render)
COOKIE_SECURE=false

# Timezone of the barbershop. Used to hide times that already passed.
TIMEZONE=Asia/Almaty

# Shown after prices
CURRENCY=₸

# How many days ahead clients can book
DAYS_AHEAD=30
